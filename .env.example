# apps/web/.env.local — Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase secrets for edge functions (supabase secrets set ...), never NEXT_PUBLIC_
COINGECKO_API_KEY=
FINNHUB_API_KEY=
ANTHROPIC_API_KEY=            # statement import + month analysis (Vercel env, server only)
RESEND_API_KEY=
CRON_SECRET=                  # bearer for /api/prices/refresh; same value in Supabase Vault as cron_secret
